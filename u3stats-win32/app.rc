#include <windows.h>

#include "version.h"

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Ultima III Assistant"
      VALUE "ProductName", "Ultima III Assistant"
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "ProductVersion", APP_VERSION_TEXT
      VALUE "CompanyName", "Krzysztof Kania"
      VALUE "InternalName", "Ultima III Assistant"
      VALUE "OriginalFilename", "Ultima III Assistant.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
